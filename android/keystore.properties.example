# Copie este arquivo para android/keystore.properties e preencha com seus dados.
# O arquivo real esta no .gitignore e NUNCA deve ser comitado.
#
# 1) Gere a keystore de upload (uma unica vez, e guarde o backup em local seguro):
#
#    keytool -genkeypair -v \
#      -keystore upload-keystore.jks \
#      -alias upload \
#      -keyalg RSA -keysize 4096 -validity 10000 \
#      -storetype PKCS12
#
#    Guarde o .jks FORA do repositorio (ex.: D:\MRZ\chaves\upload-keystore.jks).
#
# 2) Preencha os campos abaixo.
#
# storeFile aceita caminho relativo a pasta android/ ou caminho absoluto.
# No Windows, use barras normais (/) ou escape as invertidas (\\).

storeFile=D:/MRZ/chaves/upload-keystore.jks
storePassword=COLOQUE_A_SENHA_DA_KEYSTORE
keyAlias=upload
keyPassword=COLOQUE_A_SENHA_DA_CHAVE
