// Cloudflare Workers: API (worker/) + arquivos do jogo (www/) + banco D1.
//
// O GitHub Pages continua servindo a raiz do repositorio no modo offline;
// este Worker e a versao ONLINE. Ver worker/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aventura-das-notas",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",

  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },

  // Gera www/ apontando para a API deste Worker antes de cada deploy/dev.
  "build": { "command": "npm run build:cloudflare" },

  // Arquivos do jogo. O que nao for arquivo (/health, /v1/*) cai no Worker.
  "assets": { "directory": "./www" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aventura-das-notas",
      // Sem database_id o wrangler cria o banco no primeiro deploy e depois o
      // encontra pelo nome. Se preferir fixar, cole aqui o id do painel.
      "migrations_dir": "worker/migrations"
    }
  ],

  // Limites por IP. O periodo so pode ser 10 ou 60 segundos; os limites do
  // servidor original que eram por 5 ou 10 minutos foram convertidos para o
  // equivalente por minuto.
  "ratelimits": [
    { "name": "LIMITE_GLOBAL",   "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "LIMITE_AUTH",     "namespace_id": "1002", "simple": { "limit": 10,  "period": 60 } },
    { "name": "LIMITE_PARTIDAS", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "LIMITE_TURMA",    "namespace_id": "1004", "simple": { "limit": 5,   "period": 60 } },
    { "name": "LIMITE_DENUNCIA", "namespace_id": "1005", "simple": { "limit": 2,   "period": 60 } }
  ],

  // JWT_SECRET NAO fica aqui: e secret (npx wrangler secret put JWT_SECRET).
  "vars": {
    "CORS_ORIGINS": "https://localhost,capacitor://localhost,https://aventura-das-notas.marcio-zacariass.workers.dev",
    "RANKING_MOSTRA_APELIDOS": "true",
    "RANKING_TAMANHO_TOPO": "10",
    // Contas com acesso ao painel do administrador (/admin.html), separadas por virgula.
    "ADMIN_EMAILS": "marcio.zacariass@gmail.com"
  }
}
