# Copie para .env e preencha. O .env NAO vai para o git.
#
# Gere segredos fortes com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

POSTGRES_DB=aventura
POSTGRES_USER=aventura
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5433

# Segredo de assinatura dos tokens. Trocar invalida todas as sessoes.
JWT_SECRET=troque_este_segredo_por_um_aleatorio_longo

API_PORT=3000
# Em producao use 127.0.0.1 (so o proxy reverso acessa a API).
# Em dev deixe 0.0.0.0 para o celular na LAN alcancar.
API_BIND=0.0.0.0
NODE_ENV=production

# Origens permitidas no CORS, separadas por virgula.
# O app Capacitor usa https://localhost. Em dev pela LAN, inclua o IP.
# "*" e aceitavel so em desenvolvimento.
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost:5173

# Producao: dominio da API, usado pelo Caddy para emitir o certificado TLS.
DOMINIO_API=api.seudominio.com.br

# Limites de requisicao por IP. Deixe COMENTADO em producao para usar os
# defaults seguros (global 300/min, auth 20/5min, denuncia 10/10min,
# partidas 120/min, turma 20/5min). Afrouxe apenas em desenvolvimento.
#RATE_LIMIT_GLOBAL=5000
#RATE_LIMIT_AUTH=500
#RATE_LIMIT_DENUNCIA=500
#RATE_LIMIT_PARTIDAS=2000
#RATE_LIMIT_TURMA=500

# Ranking geral: false esconde os apelidos e mostra so posicoes.
#RANKING_MOSTRA_APELIDOS=true
#RANKING_TAMANHO_TOPO=10
